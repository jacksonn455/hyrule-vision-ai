{
  "name": "hyrule-vision-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Educational full-stack image classifier (Link / Zelda / Other) with a CNN trained from scratch in TensorFlow.js",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev -w @hyrule/api\" \"npm run dev -w @hyrule/web\"",
    "dev:api": "npm run dev -w @hyrule/api",
    "dev:web": "npm run dev -w @hyrule/web",
    "build": "npm run build -w @hyrule/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ml:check-env": "npm run check-env -w @hyrule/ml",
    "ml:collect-dataset": "npm run collect-dataset -w @hyrule/ml --",
    "ml:import-images": "npm run import-images -w @hyrule/ml --",
    "ml:dataset-report": "npm run dataset-report -w @hyrule/ml",
    "ml:review-dataset": "npm run review-dataset -w @hyrule/ml --",
    "ml:reorganize-raw": "npm run reorganize-raw -w @hyrule/ml --",
    "ml:sync-metadata": "npm run sync-metadata -w @hyrule/ml",
    "ml:split-dataset": "npm run split-dataset -w @hyrule/ml --",
    "ml:train": "npm run train -w @hyrule/ml --",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
